{
  "name": "sprint-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "emulators": "firebase emulators:start --only auth",
    "test:db": "node --env-file-if-exists=.env.local node_modules/.bin/vitest run --config vitest.db.config.mts",
    "test:ai": "node --env-file-if-exists=.env.local node_modules/.bin/vitest run --config vitest.ai.config.mts",
    "bench": "vitest bench --run --config vitest.bench.config.mts && node scripts/bench-report.mjs",
    "bench:baseline": "vitest bench --run --config vitest.bench.config.mts && node scripts/bench-report.mjs --save-baseline",
    "bench:check": "vitest bench --run --config vitest.bench.config.mts && node scripts/bench-report.mjs --check",
    "bench:quality": "vitest run --config vitest.quality.config.mts && node scripts/bench-report.mjs",
    "embed:sheets": "node --env-file-if-exists=.env.local scripts/embed-sheets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@google-cloud/cloud-sql-connector": "^1.12.1",
    "@google/genai": "^2.30.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "autocannon": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "firebase-tools": "^14.23.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
